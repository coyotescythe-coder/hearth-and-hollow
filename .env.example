# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides ---------------------------------------------------------

# Model that plays the Dungeon Master. Defaults to claude-opus-5.
# Set to claude-sonnet-5 for a cheaper/faster DM.
DM_MODEL=claude-opus-5

# Reasoning effort for the DM: low | medium | high | xhigh | max
# "medium" keeps turns snappy, which matters more in a game than in a chatbot.
DM_EFFORT=medium

# Model used to compact old history into summaries. Defaults to DM_MODEL.
# claude-haiku-4-5 is a good cheap choice here.
DM_SUMMARY_MODEL=

# Server port (client dev server proxies to this).
PORT=8787
